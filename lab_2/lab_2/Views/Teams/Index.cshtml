@model IEnumerable<lab_2.Models.Team>

<h1>@ViewData["Title"]</h1>
<p>Antal lag: @ViewBag.CountTeams</p>
@if (ViewBag.LastAdd != null)
{
<p>Laget som lades till senast var: @ViewBag.LastAdd</p>
}
<table class="table">
    <tr>
        <th>ID</th>
        <th>Namn</th>
        <th>Land</th>
        <th></th>
    </tr>
    @foreach (var team in Model)
    {
        <tr>
            <td>@team.TeamsID</td>
            <td>@team.Name</td>
            <td>@team.Country</td>
            <td><a asp-action="Delete" asp-route-id="@team.TeamsID"> Remove</a></td>
        </tr>
    }
</table>
